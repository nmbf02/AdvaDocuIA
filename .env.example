# Motor principal: auto | gemini | claude | openai | groq | openrouter
AI_PROVIDER=auto
# Respaldo si el principal falla (lista separada por comas)
AI_FALLBACK_PROVIDERS=gemini,claude

# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# Anthropic Claude (API, no el login de claude.ai) — https://console.anthropic.com
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# Groq — https://console.groq.com
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter (varios modelos con una clave) — https://openrouter.ai
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-sonnet-4

PORT=3000
